// ═══════════════════════════════════════════════════════════════════════════
// HUB ACCESOS — Dispatcher Jira → Job específico
// Ruta: /devsecops/portal/hub-accesos
//
// Recibe de Jira Automation y delega al job correspondiente:
//   subtipo "jenkins"    → /devsecops/portal/accesos/crear-usuario-jenkins
//   subtipo "bitbucket"  → /devsecops/portal/accesos/crear-usuario-bitbucket
//   subtipo "kubernetes" → /devsecops/portal/accesos/crear-usuario-kubernetes
// ═══════════════════════════════════════════════════════════════════════════
pipeline {
  agent any

  parameters {
    string(name: 'TICKET',       defaultValue: '',         description: 'Jira key, ej. BSJ-61')
    string(name: 'CATEGORIA',    defaultValue: 'accesos',  description: 'Dominio')
    string(name: 'SUBTIPO',      defaultValue: '',         description: 'jenkins | bitbucket | kubernetes (puede venir vacío)')
    string(name: 'SOLICITANTE',  defaultValue: '',         description: 'Email del solicitante')
    string(name: 'SUMMARY',      defaultValue: '',         description: 'Resumen del ticket')
    string(name: 'JIRA_URL',     defaultValue: '',         description: 'URL del ticket')
    string(name: 'CREATED',      defaultValue: '',         description: 'Timestamp creación')
    string(name: 'PRIORIDAD',    defaultValue: '',         description: 'Low/Medium/High')
    text  (name: 'PAYLOAD_JSON', defaultValue: '{}',       description: 'JSON con todos los datos del ticket')
  }

  options {
    timestamps()
    buildDiscarder(logRotator(numToKeepStr: '50'))
    disableConcurrentBuilds(abortPrevious: false)
  }

  environment {
    // Para futura validación de webhook (Jira manda este header)
    EXPECTED_WEBHOOK_SECRET = credentials('portal-webhook-secret-id')   // opcional, créalo después
  }

  stages {

    // ──────────────────────────────────────────────────────────────────────
    stage('🐛 DEBUG · Parámetros recibidos') {
      steps {
        script {
          echo "════════════════════════════════════════════════"
          echo "  Hub Accesos · Build #${env.BUILD_NUMBER}"
          echo "════════════════════════════════════════════════"
          echo "TICKET       : ${params.TICKET}"
          echo "CATEGORIA    : ${params.CATEGORIA}"
          echo "SUBTIPO      : '${params.SUBTIPO}'"
          echo "SOLICITANTE  : ${params.SOLICITANTE}"
          echo "SUMMARY      : ${params.SUMMARY}"
          echo "JIRA_URL     : ${params.JIRA_URL}"
          echo "CREATED      : ${params.CREATED}"
          echo "PRIORIDAD    : ${params.PRIORIDAD}"
          echo "────────────── PAYLOAD_JSON ──────────────"
          echo params.PAYLOAD_JSON
          echo "═════════════════════════════════════════════════"

          currentBuild.description = "${params.TICKET} · ${params.SOLICITANTE}"
        }
      }
    }

    // ──────────────────────────────────────────────────────────────────────
    stage('Parsear payload') {
      steps {
        script {
          // Parsear JSON
          def json = [:]
          try {
            json = readJSON text: params.PAYLOAD_JSON
          } catch (e) {
            error "PAYLOAD_JSON no es JSON válido: ${e.message}"
          }

          // Determinar subtipo (varias fuentes en orden de prioridad)
          def subtipo = (params.SUBTIPO ?: '').trim().toLowerCase()

          if (!subtipo) subtipo = (json.subtipo ?: '').toString().toLowerCase()

          // Fallback: deducir desde "servicio" del payload
          if (!subtipo) {
            def servicio = (json.servicio ?: '').toString().toLowerCase()
            if      (servicio.contains('jenkins'))     subtipo = 'jenkins'
            else if (servicio.contains('bitbucket'))   subtipo = 'bitbucket'
            else if (servicio.contains('kubernetes') ||
                     servicio.contains('k8s'))         subtipo = 'kubernetes'
          }

          if (!subtipo) {
            error "No se pudo determinar el SUBTIPO (Jenkins/Bitbucket/Kubernetes) ni desde params ni desde payload.servicio"
          }

          // Guardar para los siguientes stages
          env.SUBTIPO_FINAL  = subtipo
          env.USUARIO        = (json.datos?.usuario        ?: '').toString()
          env.HERRAMIENTA    = (json.datos?.herramienta    ?: '').toString()
          env.JUSTIFICACION  = (json.datos?.justificacion  ?: '').toString()
          env.REPOSITORIO    = (json.datos?.repositorio    ?: '').toString()
          env.PERMISO        = (json.datos?.permiso        ?: '').toString()
          env.CLUSTER        = (json.datos?.cluster        ?: '').toString()
          env.NAMESPACE_K8S  = (json.datos?.namespace      ?: '').toString()
          env.EMAIL_USUARIO  = (json.datos?.email          ?: params.SOLICITANTE).toString()

          echo "→ Subtipo final: ${env.SUBTIPO_FINAL}"
          echo "→ Usuario:       ${env.USUARIO}"
          echo "→ Herramienta:   ${env.HERRAMIENTA}"
        }
      }
    }

    // ──────────────────────────────────────────────────────────────────────
    stage('Notificar a Jira: en proceso') {
      steps {
        script {
          comentarJira(params.TICKET,
            "🔧 Hub Jenkins recibió la solicitud. Despachando a job *crear-usuario-${env.SUBTIPO_FINAL}*. " +
            "Build: ${env.BUILD_URL}"
          )
        }
      }
    }

    // ──────────────────────────────────────────────────────────────────────
    stage('Dispatch al job hijo') {
      steps {
        script {
          def jobMap = [
            'jenkins'   : '/devsecops/portal/accesos/crear-usuario-jenkins',
            'bitbucket' : '/devsecops/portal/accesos/crear-usuario-bitbucket',
            'kubernetes': '/devsecops/portal/accesos/crear-usuario-kubernetes',
            'k8s'       : '/devsecops/portal/accesos/crear-usuario-kubernetes',
          ]
          def jobName = jobMap[env.SUBTIPO_FINAL]
          if (!jobName) {
            error "Subtipo no soportado: ${env.SUBTIPO_FINAL}"
          }

          echo "Invocando ${jobName} ..."
          def downstream = build(
            job: jobName,
            wait: true,
            propagate: false,        // capturamos el resultado para reportar
            parameters: [
              string(name: 'TICKET',       value: params.TICKET),
              string(name: 'USUARIO',      value: env.USUARIO),
              string(name: 'HERRAMIENTA',  value: env.HERRAMIENTA),
              string(name: 'REPOSITORIO',  value: env.REPOSITORIO),
              string(name: 'PERMISO',      value: env.PERMISO),
              string(name: 'CLUSTER',      value: env.CLUSTER),
              string(name: 'NAMESPACE',    value: env.NAMESPACE_K8S),
              string(name: 'JUSTIFICACION',value: env.JUSTIFICACION),
              string(name: 'EMAIL',        value: env.EMAIL_USUARIO),
              text  (name: 'PAYLOAD_JSON', value: params.PAYLOAD_JSON),
            ]
          )

          env.DOWNSTREAM_RESULT = downstream.result
          env.DOWNSTREAM_URL    = downstream.absoluteUrl

          echo "Resultado downstream: ${env.DOWNSTREAM_RESULT}"
          if (env.DOWNSTREAM_RESULT != 'SUCCESS') {
            error "Job downstream falló: ${env.DOWNSTREAM_URL}"
          }
        }
      }
    }
  }

  // ════════════════════════════════════════════════════════════════════════
  post {
    success {
      script {
        comentarJira(params.TICKET,
          "✅ Acceso ${env.SUBTIPO_FINAL} provisionado correctamente para *${env.USUARIO}*.\n" +
          "Build: ${env.BUILD_URL}\nJob hijo: ${env.DOWNSTREAM_URL ?: 'N/A'}"
        )
        // (Opcional) transicionar a Done en Jira
        // transicionarJira(params.TICKET, 'Done')
      }
    }
    failure {
      script {
        comentarJira(params.TICKET,
          "❌ Falló la provisión de acceso ${env.SUBTIPO_FINAL ?: '(desconocido)'}.\n" +
          "Build: ${env.BUILD_URL}\nRevisar logs."
        )
      }
    }
  }
}

// ═══════════════════════════════════════════════════════════════════════════
// HELPERS
// ═══════════════════════════════════════════════════════════════════════════
def comentarJira(String ticketKey, String mensaje) {
  if (!ticketKey) {
    echo "⚠️ Sin TICKET key, no se comenta en Jira."
    return
  }
  withCredentials([usernamePassword(
      credentialsId: 'jira-api-credentials',     // usuario:token de Jira
      usernameVariable: 'JIRA_USER',
      passwordVariable: 'JIRA_TOKEN')]) {
    def body = """{
      "body": {
        "type": "doc",
        "version": 1,
        "content": [{
          "type": "paragraph",
          "content": [{ "type": "text", "text": ${groovy.json.JsonOutput.toJson(mensaje)} }]
        }]
      }
    }"""
    sh """
      curl -k -s -o /dev/null -w "Jira comment HTTP %{http_code}\\n" \\
        -u "\$JIRA_USER:\$JIRA_TOKEN" \\
        -H "Content-Type: application/json" \\
        -X POST "https://bancobase.atlassian.net/rest/api/3/issue/${ticketKey}/comment" \\
        -d '${body.replaceAll("'", "'\\''")}'
    """
  }
}
