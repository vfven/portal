<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>DevOps Platform · Banco BASE</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<style>
/* ================================================ */
/* BANCO BASE · DevOps Platform SPA · GLOBAL CSS   */
/* ================================================ */
:root {
  --primary: #002B5C; --primary-dark: #001F44; --primary-light: #E8EEF5;
  --secondary: #F9A800; --secondary-dark: #E09500; --secondary-light: #FEF5E6;
  --bg: #F8F9FB; --white: #FFFFFF; --dark: #1E2A3A; --dark2: #455A64;
  --gray: #6C7A89; --gray-light: #E2E8F0; --gray-bg: #F1F5F9;
  --green: #1E7B48; --green-bg: #E6F4EA; --green-border: #B8DFC6;
  --blue: #0052A5; --blue-bg: #E6F0FA; --blue-border: #B8D4F0;
  --red: #C23D1C; --red-bg: #FEF2EF; --red-border: #FCCCB8;
  --yellow: #C47D00; --yellow-bg: #FFF8E7; --yellow-border: #FFE5B4;
  --purple: #5B21B6; --purple-bg: #EDE9FE; --purple-border: #C4B5FD;
  --radius: 8px; --radius-sm: 6px;
  --shadow: 0 1px 3px rgba(0,0,0,.08); --shadow-md: 0 4px 12px rgba(0,43,92,.1);
  --transition: all 0.2s ease;
}
* { margin:0; padding:0; box-sizing:border-box; }
body { font-family:'Inter',sans-serif; background:var(--bg); color:var(--dark); line-height:1.5; }

/* ── NAV ── */
nav {
  background:var(--white); border-bottom:1px solid var(--gray-light);
  padding:0 40px; display:flex; align-items:center; height:64px;
  position:sticky; top:0; z-index:100; gap:24px; flex-wrap:wrap;
}
.nav-logo { font-weight:700; font-size:16px; color:var(--primary); display:flex; align-items:center; gap:8px; cursor:pointer; }
.nav-logo-dot { width:8px; height:8px; background:var(--secondary); border-radius:2px; }
.nav-pill { font-size:11px; font-weight:600; padding:4px 10px; border-radius:4px; background:var(--primary-light); color:var(--primary); }
.nav-links { display:flex; gap:4px; margin-left:auto; list-style:none; flex-wrap:wrap; }
.nav-links a {
  font-size:13px; font-weight:500; color:var(--gray); text-decoration:none;
  padding:8px 14px; border-radius:6px; transition:var(--transition); cursor:pointer;
}
.nav-links a:hover { background:var(--gray-bg); color:var(--primary); }
.nav-links a.active { background:var(--primary); color:var(--white); }

/* ── VIEWS (SPA routing) ── */
.view { display:none; }
.view.active { display:block; }

/* ── HERO ── */
.hero { background:var(--white); border-bottom:1px solid var(--gray-light); padding:48px 40px 40px; }
.hero-inner { max-width:1200px; margin:0 auto; }
.hero-badge {
  display:inline-flex; align-items:center; gap:8px; font-size:11px; font-weight:600;
  text-transform:uppercase; color:var(--secondary-dark); background:var(--secondary-light);
  padding:4px 12px; border-radius:4px; margin-bottom:20px;
}
.hero-badge::before { content:''; width:6px; height:6px; background:var(--secondary); border-radius:1px; }
h1 { font-weight:700; font-size:clamp(28px,4vw,38px); color:var(--primary); line-height:1.2; letter-spacing:-0.5px; margin-bottom:16px; }
h1 em { font-style:normal; color:var(--secondary-dark); }
.hero-sub { font-size:15px; color:var(--gray); max-width:560px; }

/* ── CONTAINER ── */
.container { max-width:1200px; margin:0 auto; padding:40px; }

/* ── BREADCRUMB ── */
.breadcrumb { margin-bottom:24px; font-size:13px; }
.breadcrumb a { color:var(--primary); text-decoration:none; cursor:pointer; }
.breadcrumb span { color:var(--gray); }

/* ── SECTION HEADER ── */
.section-header { display:flex; align-items:baseline; justify-content:space-between; flex-wrap:wrap; margin-bottom:24px; margin-top:40px; }
.section-header:first-of-type { margin-top:0; }
.section-header h2 { font-weight:600; font-size:20px; color:var(--primary); border-left:3px solid var(--secondary); padding-left:12px; }
.section-desc { font-size:13px; color:var(--dark2); margin-top:4px; }
.section-link { font-size:13px; color:var(--secondary-dark); text-decoration:none; cursor:pointer; }
.section-link:hover { text-decoration:underline; }

/* ── CARDS ── */
.cards-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(300px,1fr)); gap:20px; margin-bottom:20px; }
.card {
  background:var(--white); border:1px solid var(--gray-light); border-radius:var(--radius);
  padding:24px; transition:var(--transition); cursor:pointer; display:flex; flex-direction:column; gap:12px;
}
.card:hover { transform:translateY(-2px); box-shadow:var(--shadow-md); border-color:var(--secondary); }
.card-header { display:flex; justify-content:space-between; align-items:flex-start; }
.card-icon { width:48px; height:48px; background:var(--primary-light); border-radius:12px; display:flex; align-items:center; justify-content:center; }
.card-icon img { width:28px; height:28px; object-fit:contain; }
.card-badge { font-size:10px; font-weight:600; padding:4px 10px; border-radius:20px; }
.badge-access { background:var(--blue-bg); color:var(--blue); }
.badge-infra { background:var(--purple-bg); color:var(--purple); }
.badge-secret { background:var(--yellow-bg); color:var(--yellow); }
.badge-ci { background:var(--green-bg); color:var(--green); }
.card-title { font-weight:600; font-size:17px; color:var(--primary); margin-top:4px; }
.card-desc { font-size:13px; color:var(--dark2); line-height:1.5; }
.card-meta { display:flex; gap:16px; font-size:11px; color:var(--gray); margin-top:8px; }
.card-footer { display:flex; align-items:center; justify-content:space-between; padding-top:12px; border-top:1px solid var(--gray-light); margin-top:auto; }
.card-cta { font-size:13px; font-weight:500; color:var(--secondary-dark); display:flex; align-items:center; gap:4px; }

/* ── STATS ── */
.stats-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(200px,1fr)); gap:20px; margin-bottom:40px; }
.stat-card { background:var(--white); border:1px solid var(--gray-light); border-radius:var(--radius); padding:20px; text-align:center; }
.stat-number { font-size:32px; font-weight:700; color:var(--primary); }
.stat-label { font-size:12px; color:var(--gray); margin-top:4px; }

/* ── TOOLS GRID (Catalogo) ── */
.tools-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(200px,1fr)); gap:16px; margin-bottom:20px; }
.tool-card {
  background:var(--white); border:1px solid var(--gray-light); border-radius:var(--radius);
  padding:16px; display:flex; align-items:center; gap:12px; cursor:pointer; transition:var(--transition);
}
.tool-card:hover { box-shadow:var(--shadow-md); border-color:var(--secondary); transform:translateY(-1px); }
.tool-icon { width:40px; height:40px; background:var(--primary-light); border-radius:10px; display:flex; align-items:center; justify-content:center; flex-shrink:0; overflow:hidden; }
.tool-icon img { width:100%; height:100%; object-fit:contain; }
.tool-info h3 { font-size:14px; font-weight:600; color:var(--primary); }
.tool-info p { font-size:11px; color:var(--gray); margin-top:2px; }
.tool-arrow { margin-left:auto; color:var(--gray-light); font-size:16px; }

/* ── TEMPLATES GRID (Catalogo + Plantillas) ── */
.templates-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(260px,1fr)); gap:16px; margin-bottom:32px; }
.template-card {
  background:var(--white); border:1px solid var(--gray-light); border-radius:var(--radius);
  padding:20px; cursor:pointer; transition:var(--transition); position:relative;
}
.template-card:hover { box-shadow:var(--shadow-md); border-color:var(--secondary); }
.template-badge {
  display:inline-block; font-size:10px; font-weight:600; padding:3px 8px;
  border-radius:4px; margin-bottom:12px; background:var(--primary-light); color:var(--primary);
}
.template-card h3 { font-size:15px; font-weight:600; color:var(--primary); margin-bottom:8px; }
.template-card p { font-size:12px; color:var(--dark2); line-height:1.5; margin-bottom:12px; }
.template-tags { display:flex; flex-wrap:wrap; gap:6px; }
.tag { font-size:10px; padding:3px 8px; background:var(--gray-bg); color:var(--gray); border-radius:4px; }

/* ── FORM ── */
.form-card { background:var(--white); border:1px solid var(--gray-light); border-radius:var(--radius); padding:28px; margin:24px 0; }
.form-grid { display:grid; grid-template-columns:1fr 1fr; gap:0 20px; }
.form-group { margin-bottom:20px; }
.form-group.full-width { grid-column:1/-1; }
.form-label { font-weight:500; font-size:13px; color:var(--primary); display:block; margin-bottom:6px; }
.form-label .required { color:var(--red); }
.form-input,.form-select,.form-textarea {
  width:100%; padding:10px 12px; border:1px solid var(--gray-light); border-radius:6px;
  font-size:13px; font-family:'Inter',sans-serif; transition:var(--transition);
}
.form-input:focus,.form-select:focus,.form-textarea:focus { outline:none; border-color:var(--secondary); box-shadow:0 0 0 3px var(--secondary-light); }
.btn-primary { background:var(--primary); color:var(--white); padding:12px 24px; border:none; border-radius:6px; font-weight:600; font-size:14px; cursor:pointer; transition:var(--transition); width:100%; }
.btn-primary:hover { background:var(--primary-dark); }
.btn-secondary { background:var(--white); color:var(--primary); padding:10px 20px; border:1px solid var(--gray-light); border-radius:6px; font-weight:500; font-size:13px; cursor:pointer; text-decoration:none; display:inline-block; transition:var(--transition); }
.btn-secondary:hover { background:var(--gray-bg); }
.feedback { display:none; padding:16px; border-radius:6px; margin-top:20px; font-size:13px; }
.feedback.success { background:var(--green-bg); color:var(--green); border:1px solid var(--green-border); display:block; }
.feedback.error { background:var(--red-bg); color:var(--red); border:1px solid var(--red-border); display:block; }

/* ── FILTERS ── */
.filters { display:flex; gap:12px; margin-bottom:32px; flex-wrap:wrap; }
.filter-btn { padding:6px 16px; border-radius:20px; border:1px solid var(--gray-light); background:var(--white); font-size:12px; font-weight:500; color:var(--gray); cursor:pointer; transition:var(--transition); }
.filter-btn.active,.filter-btn:hover { background:var(--primary); color:var(--white); border-color:var(--primary); }

/* ── HERRAMIENTAS DETAILED ── */
.tools-detailed-grid { display:flex; flex-direction:column; gap:24px; }
.tool-detailed-card { background:var(--white); border:1px solid var(--gray-light); border-radius:var(--radius); overflow:hidden; transition:var(--transition); }
.tool-detailed-card:hover { box-shadow:var(--shadow-md); }
.tool-header { display:flex; align-items:center; justify-content:space-between; padding:20px 24px; cursor:pointer; flex-wrap:wrap; gap:12px; }
.tool-title-section { display:flex; align-items:center; gap:16px; flex-wrap:wrap; }
.tool-icon-large { width:48px; height:48px; background:var(--primary-light); border-radius:12px; display:flex; align-items:center; justify-content:center; overflow:hidden; }
.tool-icon-large img { width:100%; height:100%; object-fit:contain; }
.tool-info h2 { font-weight:600; font-size:18px; color:var(--primary); margin-bottom:4px; }
.tool-info p { font-size:12px; color:var(--gray); }
.tool-status { display:flex; align-items:center; gap:8px; flex-wrap:wrap; }
.status-badge { display:inline-flex; align-items:center; gap:6px; font-size:12px; font-weight:600; padding:4px 12px; border-radius:20px; }
.status-operational { background:var(--green-bg); color:var(--green); border:1px solid var(--green-border); }
.status-operational::before { content:"●"; font-size:10px; }
.status-warning { background:var(--yellow-bg); color:var(--yellow); border:1px solid var(--yellow-border); }
.status-warning::before { content:"●"; font-size:10px; }
.status-incident { background:var(--red-bg); color:var(--red); border:1px solid var(--red-border); }
.status-incident::before { content:"●"; font-size:10px; }
.version-badge { font-size:11px; color:var(--gray); background:var(--gray-bg); padding:4px 8px; border-radius:4px; }
.tool-expand { font-size:20px; color:var(--gray-light); transition:transform 0.2s; }
.tool-expand.open { transform:rotate(180deg); }
.tool-body { display:none; padding:24px; background:var(--gray-bg); border-top:1px solid var(--gray-light); }
.tool-body.open { display:block; }
.env-section h3 { font-size:14px; font-weight:600; color:var(--primary); margin-bottom:12px; }
.env-buttons { display:flex; flex-wrap:wrap; gap:12px; margin-bottom:20px; }
.env-link { display:inline-flex; align-items:center; gap:8px; padding:8px 16px; background:var(--white); border:1px solid var(--gray-light); border-radius:6px; text-decoration:none; font-size:13px; font-weight:500; color:var(--primary); transition:var(--transition); }
.env-link:hover { background:var(--primary-light); border-color:var(--primary); transform:translateY(-1px); }
.env-badge-small { font-size:9px; font-weight:600; padding:2px 6px; border-radius:4px; }
.env-badge-dev { background:var(--blue-bg); color:var(--blue); }
.env-badge-qa { background:var(--secondary-light); color:var(--secondary-dark); }
.env-badge-stg { background:var(--purple-bg); color:var(--purple); }
.env-badge-prd { background:var(--red-bg); color:var(--red); }
.info-grid-tool { display:grid; grid-template-columns:repeat(auto-fit,minmax(180px,1fr)); gap:12px; padding-top:16px; border-top:1px solid var(--gray-light); }
.info-item { background:var(--white); padding:12px; border-radius:6px; }
.info-label { font-size:10px; font-weight:600; text-transform:uppercase; color:var(--gray); letter-spacing:0.5px; }
.info-value { font-size:13px; color:var(--dark); margin-top:4px; }
.info-value a { color:var(--primary); text-decoration:none; }
.info-value a:hover { text-decoration:underline; }

/* ── SERVICES GRID (Solicitar) ── */
.services-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(160px,1fr)); gap:16px; margin-bottom:40px; }
.service-card { background:var(--white); border:1px solid var(--gray-light); border-radius:var(--radius); padding:20px 16px; text-align:center; cursor:pointer; transition:var(--transition); position:relative; }
.service-card:hover { border-color:var(--secondary); box-shadow:var(--shadow-md); transform:translateY(-2px); }
.service-icon { width:56px; height:56px; margin:0 auto 12px; display:flex; align-items:center; justify-content:center; overflow:hidden; }
.service-icon img { width:100%; height:100%; object-fit:contain; display:block; }
.service-name { font-size:13px; font-weight:600; color:var(--primary); margin-bottom:6px; }
.service-desc { font-size:11px; color:var(--gray); line-height:1.4; margin-bottom:10px; }
.service-badge { font-size:10px; font-weight:600; padding:3px 8px; border-radius:20px; background:var(--green-bg); color:var(--green); display:inline-block; }
.service-badge.soon { background:var(--gray-bg); color:var(--gray); }

/* ── QUICK ACTIONS ── */
.quick-actions { display:flex; flex-wrap:wrap; gap:12px; margin-bottom:32px; }
.quick-btn { padding:10px 18px; background:var(--white); border:1px solid var(--gray-light); border-radius:6px; font-size:13px; font-weight:500; color:var(--primary); cursor:pointer; transition:var(--transition); }
.quick-btn:hover { background:var(--primary-light); border-color:var(--primary); }
.info-box { background:var(--blue-bg); border:1px solid var(--blue-border); border-radius:6px; padding:14px 18px; margin-bottom:20px; font-size:13px; color:var(--blue); }

/* ── PLANTILLAS ── */
.guide-section { background:var(--white); border:1px solid var(--gray-light); border-radius:var(--radius); margin:32px 0; overflow:hidden; }
.guide-header { display:flex; align-items:center; justify-content:space-between; padding:20px 24px; cursor:pointer; }
.guide-header h2 { font-size:18px; font-weight:600; color:var(--primary); }
.guide-expand { font-size:20px; color:var(--gray-light); transition:transform 0.2s; }
.guide-expand.open { transform:rotate(180deg); }
.guide-body { display:none; padding:24px; border-top:1px solid var(--gray-light); }
.guide-body.open { display:block; }
.step { margin-bottom:24px; }
.step-title { display:flex; align-items:center; gap:12px; font-size:15px; font-weight:600; color:var(--primary); margin-bottom:12px; }
.step-number { width:28px; height:28px; background:var(--secondary); border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:13px; font-weight:700; color:var(--white); flex-shrink:0; }
.structure-tree { background:var(--gray-bg); padding:16px; border-radius:6px; font-family:monospace; font-size:12px; line-height:1.8; }
.code-block { background:var(--dark); color:#e2e8f0; padding:16px; border-radius:6px; font-family:monospace; font-size:12px; overflow-x:auto; margin:12px 0; }
.code-block code { white-space:pre; }
.note-box { background:var(--secondary-light); border:1px solid #ffd86b; border-radius:6px; padding:14px 18px; margin:16px 0; font-size:13px; }
.download-link { display:inline-flex; align-items:center; gap:8px; color:var(--primary); font-weight:500; font-size:13px; text-decoration:none; margin-top:16px; }
.download-link:hover { text-decoration:underline; }

/* ── MODAL ── */
.modal-overlay { display:none; position:fixed; inset:0; background:rgba(0,0,0,.5); backdrop-filter:blur(2px); z-index:1000; align-items:center; justify-content:center; }
.modal-overlay.active { display:flex; }
.modal { background:var(--white); border-radius:12px; max-width:560px; width:90%; max-height:85vh; overflow-y:auto; box-shadow:0 20px 40px rgba(0,0,0,.2); }
.modal-header { padding:24px; display:flex; justify-content:space-between; align-items:center; border-bottom:1px solid var(--gray-light); }
.modal-header h3 { font-size:18px; font-weight:700; color:var(--primary); }
.modal-close { width:32px; height:32px; border-radius:6px; border:1px solid var(--gray-light); background:transparent; cursor:pointer; font-size:18px; color:var(--gray); transition:var(--transition); display:flex; align-items:center; justify-content:center; }
.modal-close:hover { background:var(--gray-bg); color:var(--primary); }
.modal-close::before { content: '✕'; }
.modal-body { padding:24px; }

/* ── DESPLIEGUE ── */
.info-card { background:var(--white); border:1px solid var(--gray-light); border-radius:var(--radius); padding:20px; margin:16px 0; }
.info-card h3 { font-size:15px; font-weight:600; color:var(--primary); margin-bottom:8px; }
.info-card p { font-size:13px; color:var(--dark2); line-height:1.6; }
.diagram { background:var(--white); border:1px solid var(--gray-light); border-radius:var(--radius); padding:32px; margin:24px 0; text-align:center; }
.diagram-caption { font-size:11px; color:var(--gray); margin-top:16px; }
.info-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(240px,1fr)); gap:20px; margin:20px 0; }
.flow-steps { display:flex; align-items:center; gap:0; flex-wrap:wrap; margin:20px 0; }
.flow-step { background:var(--primary-light); border:1px solid var(--primary); border-radius:6px; padding:10px 16px; font-size:13px; font-weight:500; color:var(--primary); }
.flow-arrow { color:var(--secondary); font-size:20px; padding:0 8px; }

/* ── FOOTER ── */
.page-footer { margin-top:48px; padding-top:24px; border-top:1px solid var(--gray-light); text-align:center; font-size:12px; color:var(--gray); }
.page-footer a { color:var(--primary); }

/* ── RESPONSIVE ── */
@media(max-width:768px) {
  nav { padding:12px 20px; height:auto; }
  .nav-links { margin-left:0; }
  .hero { padding:32px 20px; }
  .container { padding:24px; }
  .cards-grid,.tools-grid,.services-grid { grid-template-columns:1fr; }
  .form-grid { grid-template-columns:1fr; }
  .form-group.full-width { grid-column:auto; }
  .flow-steps { flex-direction:column; align-items:flex-start; }
}
</style>
</head>
<body>

<nav>
  <div class="nav-logo" onclick="navigate('catalogo')">
    <div class="nav-logo-dot"></div>DevOps Platform
  </div>
  <span class="nav-pill">Banco BASE</span>
  <ul class="nav-links">
    <li><a onclick="navigate('catalogo')" data-view="catalogo" class="active">Catálogo</a></li>
    <li><a onclick="navigate('herramientas')" data-view="herramientas">Herramientas</a></li>
    <li><a onclick="navigate('plantillas')" data-view="plantillas">Plantillas</a></li>
    <li><a onclick="navigate('solicitar')" data-view="solicitar">Solicitar</a></li>
    <li><a onclick="navigate('autoservicio')" data-view="autoservicio">Autoservicio</a></li>
    <li><a onclick="navigate('despliegue')" data-view="despliegue">Despliegue</a></li>
  </ul>
</nav>

<div class="view active" id="view-catalogo">
  <div class="hero">
    <div class="hero-inner">
      <div class="hero-badge">Plataforma DevOps</div>
      <h1>Catálogo de <em>Servicios</em></h1>
      <p class="hero-sub">Herramientas, plantillas y recursos para acelerar el desarrollo seguro en Banco BASE.</p>
    </div>
  </div>
  <div class="container">
    <div class="section-header">
      <h2>Herramientas Disponibles</h2>
      <a class="section-link" onclick="navigate('herramientas')">Ver todas →</a>
    </div>
    <div class="tools-grid" id="cat-toolsGrid"></div>

    <div class="section-header">
      <h2>Plantillas de Código</h2>
      <a class="section-link" onclick="navigate('plantillas')">Ver repositorio →</a>
    </div>
    <div class="templates-grid" id="cat-templatesGrid"></div>

    <div class="section-header"><h2>Solicitar Nuevo Servicio</h2></div>
    <div class="form-card">
      <p style="margin-bottom:20px;color:var(--dark2);font-size:14px;">¿Necesitas una nueva herramienta, repositorio base o automatización? Completa el formulario y el equipo de DevOps evaluará tu solicitud.</p>
      <form id="cat-serviceForm" onsubmit="return false;">
        <div class="form-group">
          <label class="form-label">Tipo de solicitud <span class="required">*</span></label>
          <select class="form-select" id="cat-requestType" required>
            <option value="">Selecciona...</option>
            <option value="herramienta">Nueva herramienta / integración</option>
            <option value="plantilla">Nueva plantilla / boilerplate</option>
            <option value="automatizacion">Nueva automatización / pipeline</option>
            <option value="mejora">Mejora a servicio existente</option>
          </select>
        </div>
        <div class="form-group">
          <label class="form-label">Nombre del servicio <span class="required">*</span></label>
          <input type="text" class="form-input" id="cat-serviceName" placeholder="ej: GitLab CI, Argo Rollouts, etc." required>
        </div>
        <div class="form-group">
          <label class="form-label">Descripción <span class="required">*</span></label>
          <textarea class="form-textarea" id="cat-serviceDesc" rows="3" placeholder="¿Qué problema resuelve? ¿Para qué equipo o aplicación?" required></textarea>
        </div>
        <div class="form-group">
          <label class="form-label">Tu equipo</label>
          <input type="text" class="form-input" id="cat-team" placeholder="ej: Equipo Pagos Digitales">
        </div>
        <button type="submit" class="btn-primary" onclick="submitForm('cat-feedback','cat-serviceForm')">Enviar solicitud</button>
      </form>
      <div id="cat-feedback" class="feedback"></div>
    </div>
    <div class="page-footer">DevOps Platform Engineering · <a href="#">Reportar problema</a></div>
  </div>
</div>

