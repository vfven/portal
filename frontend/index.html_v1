];

const SERVICIOS = [
  { id:'docker-postgres', nombre:'PostgreSQL DB', desc:'Instancia relacional con persistencia configurada', icono:'https://cdn.jsdelivr.net/gh/devicons/devicon/icons/postgresql/postgresql-original.svg', cat:'db', tiempo:'10 min', disponible:true },
  { id:'docker-redis', nombre:'Redis Cache', desc:'Caché en memoria con persistencia', icono:'https://cdn.jsdelivr.net/gh/devicons/devicon/icons/redis/redis-original.svg', cat:'cache', tiempo:'5 min', disponible:true },
  { id:'docker-mongo', nombre:'MongoDB', desc:'Base de datos NoSQL para documentos', icono:'https://cdn.jsdelivr.net/gh/devicons/devicon/icons/mongodb/mongodb-original.svg', cat:'db', tiempo:'Próximamente', disponible:false },
  { id:'jenkins-agent', nombre:'Jenkins Agent', desc:'Nodo worker integrado para tareas pesadas', icono:'https://cdn.jsdelivr.net/gh/devicons/devicon/icons/jenkins/jenkins-original.svg', cat:'ci-cd', tiempo:'15 min', disponible:true },
  { id:'argocd-app', nombre:'App Argo CD', desc:'Registro inmediato GitOps de aplicación', icono:'https://cdn.jsdelivr.net/gh/devicons/devicon/icons/argocd/argocd-original.svg', cat:'gitops', tiempo:'10 min', disponible:true },
  { id:'sonar-project', nombre:'Proyecto SonarQube', desc:'Métricas estáticas y Quality Gates configurados', icono:'https://cdn.jsdelivr.net/gh/devicons/devicon/icons/sonarqube/sonarqube-original.svg', cat:'quality', tiempo:'5 min', disponible:true },
  { id:'k8s-namespace', nombre:'Namespace K8s', desc:'Aislamiento total con quotas y networkpolicies', icono:'https://cdn.simpleicons.org/kubernetes/326CE5', cat:'k8s', tiempo:'10 min', disponible:true },
  { id:'terraform-ws', nombre:'Terraform Workspace', desc:'Infraestructura como código aislada', icono:'https://cdn.jsdelivr.net/gh/devicons/devicon/icons/terraform/terraform-original.svg', cat:'iac', tiempo:'10 min', disponible:true },
  { id:'grafana-dash', nombre:'Dashboard Grafana', desc:'Panel centralizado conectado a Prometheus', icono:'https://cdn.jsdelivr.net/gh/devicons/devicon/icons/grafana/grafana-original.svg', cat:'monitoring', tiempo:'20 min', disponible:true }
];

const AUTOSERVICIO = {
  accesos: [
    { id:'acc-jenkins', nombre:'Acceso a Jenkins', desc:'Permisos para ejecutar pipelines, ver logs y administrar jobs.', icono:'https://cdn.jsdelivr.net/gh/devicons/devicon/icons/jenkins/jenkins-original.svg', badge:'Acceso', badgeClass:'badge-access', tiempo:'~30 min', campos:[{name:'usuario',label:'Usuario corporativo',type:'text',ph:'ej: jperez'},{name:'herramienta',label:'Instancia',type:'select',opts:['Jenkins DEV','Jenkins QA','Jenkins PRD']},{name:'justificacion',label:'Justificación',type:'textarea',ph:'¿Por qué necesitas acceso?'}] },
    { id:'acc-bitbucket', nombre:'Acceso a Bitbucket', desc:'Permisos de lectura/escritura en repositorios específicos.', icono:'https://cdn.jsdelivr.net/gh/devicons/devicon/icons/bitbucket/bitbucket-original.svg', badge:'Acceso', badgeClass:'badge-access', tiempo:'~30 min', campos:[{name:'usuario',label:'Usuario corporativo',type:'text',ph:'ej: jperez'},{name:'repositorio',label:'Repositorio(s)',type:'text',ph:'ej: equipo-core/api-pagos'},{name:'permiso',label:'Nivel de permiso',type:'select',opts:['Lectura','Escritura','Administrador']}] },
    { id:'acc-k8s', nombre:'Acceso a Kubernetes', desc:'Acceso RBAC a namespaces en los clústeres K8s.', icono:'https://cdn.simpleicons.org/kubernetes/326CE5', badge:'Acceso', badgeClass:'badge-access', tiempo:'~1h', campos:[{name:'usuario',label:'Usuario corporativo',type:'text',ph:'ej: jperez'},{name:'cluster',label:'Clúster',type:'select',opts:['On-Prem DEV','On-Prem QA','Cloud DEV','Cloud PRD']},{name:'namespace',label:'Namespace(s)',type:'text',ph:'ej: dev-apps, qa-pagos'},{name:'justificacion',label:'Justificación',type:'textarea',ph:'¿Para qué aplicación?'}] }
  ],
  infra: [
    { id:'inf-bd', nombre:'Base de Datos Dedicada', desc:'Nueva BD relacional aprovisionada de manera instantánea.', icono:'https://cdn.jsdelivr.net/gh/devicons/devicon/icons/postgresql/postgresql-original.svg', badge:'Infraestructura', badgeClass:'badge-infra', tiempo:'~15 min', campos:[{name:'db_name',label:'Nombre BD',type:'text',ph:'ej: catalogos_db'},{name:'motor',label:'Motor',type:'select',opts:['PostgreSQL','Redis']}] }
  ],
  secretos: [
    { id:'sec-k8s', nombre:'Secret Kubernetes', desc:'Secret cifrado de K8s para inyección segura de variables de entorno.', icono:'https://cdn.jsdelivr.net/gh/devicons/devicon/icons/vault/vault-original.svg', badge:'Secretos', badgeClass:'badge-secret', tiempo:'~15 min', campos:[{name:'namespace',label:'Namespace',type:'text',ph:'ej: dev-apps'},{name:'secret_name',label:'Nombre del Secret',type:'text',ph:'ej: app-credentials'},{name:'data',label:'Datos (key=value)',type:'textarea',ph:'ej: username=admin\npassword=secret123'}] }
  ]
};

// ═══════════════════════════════════════════════════════
// SPA ROUTER
// ═══════════════════════════════════════════════════════
const VIEWS = ['catalogo','herramientas','plantillas','solicitar','autoservicio','despliegue'];

function navigate(viewId) {
  VIEWS.forEach(v => {
    document.getElementById('view-'+v).classList.toggle('active', v === viewId);
  });
  document.querySelectorAll('.nav-links a').forEach(a => {
    a.classList.toggle('active', a.dataset.view === viewId);
  });
  window.scrollTo({top:0, behavior:'smooth'});
  
  if (viewId === 'herramientas' && !window._herLoaded) { renderHerramientas(); window._herLoaded = true; }
  if (viewId === 'plantillas' && !window._plaLoaded) { renderPlantillas(); window._plaLoaded = true; }
  if (viewId === 'solicitar' && !window._solLoaded) { renderServicios(); window._solLoaded = true; }
  if (viewId === 'autoservicio' && !window._autLoaded) { renderAutoservicio(); window._autLoaded = true; }
  
  history.pushState({view:viewId}, '', '#'+viewId);
}

window.addEventListener('popstate', e => {
  if (e.state && e.state.view) navigate(e.state.view);
});

// Init SPA view from Hash
const initView = window.location.hash.replace('#','') || 'catalogo';
if (VIEWS.includes(initView)) {
  setTimeout(() => navigate(initView), 50);
}

// ═══════════════════════════════════════════════════════
// RENDER COMPONENT METHODS
// ═══════════════════════════════════════════════════════
(function renderCatalogo() {
  const tg = document.getElementById('cat-toolsGrid');
  if(tg) {
    tg.innerHTML = HERRAMIENTAS.slice(0, 4).map(h => `
      <div class="tool-card" onclick="navigate('herramientas')">
        <div class="tool-icon"><img src="${h.icono}" alt="${h.nombre}"></div>
        <div class="tool-info"><h3>${h.nombre}</h3><p>${h.desc}</p></div>
        <div class="tool-arrow">→</div>
      </div>`).join('');
  }
  const tpg = document.getElementById('cat-templatesGrid');
  if(tpg) {
    tpg.innerHTML = PLANTILLAS.slice(0,4).map(p => `
      <div class="template-card" onclick="navigate('plantillas')">
        <span class="template-badge">${p.badge}</span>
        <h3>${p.nombre}</h3>
        <p>${p.desc}</p>
        <div class="template-tags">${p.tags.map(t=>`<span class="tag">${t}</span>`).join('')}</div>
      </div>`).join('');
  }
})();

function renderHerramientas(filtro='all') {
  const grid = document.getElementById('her-toolsGrid');
  if(!grid) return;
  const filtradas = filtro === 'all' ? HERRAMIENTAS : HERRAMIENTAS.filter(h => h.estado === filtro);
  const estadoMap = {
    operational:['status-operational','Operativo'],
    warning:['status-warning','Atención'],
    incident:['status-incident','Incidente']
  };
  grid.innerHTML = filtradas.map(h => {
    const [cls, txt] = estadoMap[h.estado] || ['',''];
    return `
    <div class="tool-detailed-card">
      <div class="tool-header" onclick="toggleTool('${h.id}')">
        <div class="tool-title-section">
          <div class="tool-icon-large"><img src="${h.icono}" alt="${h.nombre}"></div>
          <div class="tool-info"><h2>${h.nombre}</h2><p>${h.desc}</p></div>
        </div>
        <div class="tool-status">
          <span class="status-badge ${cls}">${txt}</span>
          <span class="version-badge">v${h.version}</span>
          <span class="tool-expand" id="exp-${h.id}">▼</span>
        </div>
      </div>
      <div class="tool-body" id="body-${h.id}">
        <div class="env-section">
          <h3>Accesos directos</h3>
          <div class="env-buttons">
            ${h.entornos.map(e=>`<a href="${e.url}" class="env-link" target="_blank" onclick="event.stopPropagation()">${e.nombre} <span class="env-badge-small env-badge-${e.badge}">${e.text}</span></a>`).join('')}
          </div>
        </div>
        <div class="info-grid-tool">
          <div class="info-item"><div class="info-label">SLA</div><div class="info-value">${h.sla}</div></div>
          <div class="info-item"><div class="info-label">Owner</div><div class="info-value">${h.owner}</div></div>
          <div class="info-item"><div class="info-label">Docs</div><div class="info-value"><a href="${h.doc}" target="_blank" onclick="event.stopPropagation()">Ver documentación →</a></div></div>
        </div>
      </div>
    </div>`;
  }).join('');
  document.getElementById('her-lastUpdate').textContent = new Date().toLocaleString('es-MX',{day:'numeric',month:'long',hour:'2-digit',minute:'2-digit'});
}

function toggleTool(id) {
  const el = document.getElementById('body-'+id);
  const exp = document.getElementById('exp-'+id);
  if(el) { el.classList.toggle('open'); }
  if(exp) { exp.classList.toggle('open'); }
}

function renderPlantillas(filtro='all') {
  const grid = document.getElementById('pla-templatesGrid');
  if(!grid) return;
  const filtradas = filtro === 'all' ? PLANTILLAS : PLANTILLAS.filter(p => p.cat === filtro);
  grid.innerHTML = filtradas.map(p => `
    <div class="template-card" onclick="openTemplateModal('${p.nombre}')">
      <span class="template-badge">${p.badge}</span>
      <h3>${p.nombre}</h3>
      <p>${p.desc}</p>
      <div class="template-tags">${p.tags.map(t=>`<span class="tag">${t}</span>`).join('')}</div>
    </div>`).join('');
}

function toggleGuide() {
  document.getElementById('guideBody').classList.toggle('open');
  document.getElementById('guideExpand').classList.toggle('open');
}

function renderServicios() {
  const grid = document.getElementById('sol-servicesGrid');
  if(!grid) return;
  grid.innerHTML = SERVICIOS.map(s => `
    <div class="service-card" ${s.disponible ? `onclick="quickFill('${s.nombre}','Aprovisionamiento automático de ${s.desc}')"` : ''}>
      <div class="service-icon"><img src="${s.icono}" alt="${s.nombre}"></div>
      <div class="service-name">${s.nombre}</div>
      <div class="service-desc">${s.desc}</div>
      <span class="service-badge ${s.disponible?'':'soon'}">${s.disponible?'⏱ '+s.tiempo : s.tiempo}</span>
    </div>`).join('');
}

function quickFill(nombre, desc) {
  document.getElementById('sol-serviceName').value = nombre;
  document.getElementById('sol-serviceDesc').value = desc;
  document.getElementById('sol-serviceType').value = 'herramienta';
  const card = document.getElementById('sol-formCard');
  card.scrollIntoView({behavior:'smooth'});
  card.style.boxShadow = '0 0 0 2px var(--secondary)';
  setTimeout(()=>{ card.style.boxShadow = ''; }, 2000);
}

function renderAutoservicio() {
  renderCards(AUTOSERVICIO.accesos, 'aut-accesosGrid');
  renderCards(AUTOSERVICIO.infra, 'aut-infraGrid');
  renderCards(AUTOSERVICIO.secretos, 'aut-secretosGrid');
}

function renderCards(items, containerId) {
  const target = document.getElementById(containerId);
  if(!target) return;
  target.innerHTML = items.map(s => `
    <div class="card" onclick="openAutoModal('${s.id}')">
      <div class="card-header">
        <div class="card-icon"><img src="${s.icono}" alt="${s.nombre}"></div>
        <span class="card-badge ${s.badgeClass}">${s.badge}</span>
      </div>
      <div class="card-title">${s.nombre}</div>
      <div class="card-desc">${s.desc}</div>
      <div class="card-meta"><span>⏱ ${s.tiempo}</span></div>
      <div class="card-footer"><div class="card-cta">Solicitar →</div></div>
    </div>`).join('');
}

// ═══════════════════════════════════════════════════════
// MODAL LOGIC & GENERIC FORM SUBMISSION
// ═══════════════════════════════════════════════════════
function openAutoModal(id) {
  const allItems = [...AUTOSERVICIO.accesos, ...AUTOSERVICIO.infra, ...AUTOSERVICIO.secretos];
  const s = allItems.find(x => x.id === id);
  if(!s) return;
  
  document.getElementById('modalTitle').textContent = s.nombre;
  let html = `<p style="font-size:13px; color:var(--dark2); margin-bottom:16px;">${s.desc}</p>`;
  html += `<form id="modal-form" onsubmit="event.preventDefault(); submitForm('modal-feedback','modal-form');">`;
  
  s.campos.forEach(c => {
    html += `<div class="form-group">
      <label class="form-label">${c.label} <span class="required">*</span></label>`;
    if(c.type === 'select') {
      html += `<select class="form-select" required><option value="">Selecciona...</option>${c.opts.map(o=>`<option value="${o}">${o}</option>`).join('')}</select>`;
    } else if(c.type === 'textarea') {
      html += `<textarea class="form-textarea" rows="3" placeholder="${c.ph}" required></textarea>`;
    } else {
      html += `<input type="text" class="form-input" placeholder="${c.ph}" required>`;
    }
    html += `</div>`;
  });
  
  html += `<button type="submit" class="btn-primary">Enviar Solicitud</button></form><div id="modal-feedback" class="feedback"></div>`;
  
  document.getElementById('modalBody').innerHTML = html;
  document.getElementById('modalOverlay').classList.add('active');
}

function closeModal() {
  document.getElementById('modalOverlay').classList.remove('active');
}

function openTemplateModal(name) {
  const p = PLANTILLAS.find(x => x.nombre === name);
  if(!p) return;
  document.getElementById('templateModalTitle').textContent = p.nombre;
  document.getElementById('templateModalBody').innerHTML = `
    <p style="font-size:13px; margin-bottom:12px;">${p.desc}</p>
    <div class="info-box">Repositorio: <a href="${p.url}" target="_blank" style="color:inherit; font-weight:600;">${p.url}</a></div>
    <div class="form-label">Vista del archivo principal:</div>
    <div class="code-block"><code>${p.code}</code></div>
  `;
  document.getElementById('templateModalOverlay').classList.add('active');
}

function closeTemplateModal() {
  document.getElementById('templateModalOverlay').classList.remove('active');
}

function submitForm(fbId, formId) {
  const form = document.getElementById(formId);
  if (!form.checkValidity()) { form.reportValidity(); return; }
  const key = 'SRV-' + new Date().getFullYear() + '-' + Math.floor(Math.random()*9000+1000);
  const fb = document.getElementById(fbId);
  fb.className = 'feedback success';
  fb.innerHTML = `✅ <strong>${key}</strong> — Solicitud procesada e integrada con éxito.<br>El equipo DevOps responderá en un plazo máximo de 2 horas hábiles.`;
  form.reset();
  setTimeout(() => { fb.className = 'feedback'; fb.innerHTML = ''; }, 6000);
}

// Global Event Listeners to close modals clicking outside
document.getElementById('modalOverlay').addEventListener('click', e => { if(e.target.id === 'modalOverlay') closeModal(); });
document.getElementById('templateModalOverlay').addEventListener('click', e => { if(e.target.id === 'templateModalOverlay') closeTemplateModal(); });

// Filter Button Bindings
document.addEventListener('click', e => {
  if(e.target.classList.contains('filter-btn')) {
    const parent = e.target.parentElement;
    parent.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
    e.target.classList.add('active');
    const f = e.target.dataset.filter;
    if(parent.id === 'pla-filters') { renderPlantillas(f); } else { renderHerramientas(f); }
  }
});
</script>
</body>
</html>